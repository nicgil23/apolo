{
  "manifest_version": 3,
  "name": "Apolo - YouTube & Music Downloader",
  "version": "1.1.0",
  "description": "Descarga canciones, álbumes y playlists de YouTube y YouTube Music directamente a tu biblioteca Apolo.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Apolo Downloader",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "http://127.0.0.1:4533/*",
    "http://localhost:4533/*"
  ]
}
